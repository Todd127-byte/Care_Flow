<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CareFlow.ViewModels"
        xmlns:views="using:CareFlow.Views"
        x:Class="CareFlow.MainWindow"
        Title="CareFlow – Diagnostic Booking Management"
        Width="1100" Height="760" MinWidth="850" MinHeight="600"
        Background="#F3F7FA">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BookingViewModel}"><views:BookingView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:BookingHistoryViewModel}"><views:BookingHistoryView /></DataTemplate>
  </Window.DataTemplates>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2EAF0" BorderThickness="0,0,0,1" Padding="26,16">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#E6F5F5" CornerRadius="12" Width="42" Height="42">
            <TextBlock Text="+" FontSize="30" FontWeight="Bold" Foreground="#087F8C" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="CareFlow" FontSize="21" FontWeight="Bold" Foreground="#15334A" />
            <TextBlock Text="DIAGNOSTIC BOOKING MANAGEMENT" FontSize="10" Foreground="#708493" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Classes="nav" />
          <Button Content="New booking" Command="{Binding ShowBookingCommand}" Classes="nav primary" />
          <Button Content="Booking history" Command="{Binding ShowHistoryCommand}" Classes="nav" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#FFF2E7" Padding="22,10" IsVisible="{Binding HasStartupError}">
        <TextBlock Text="{Binding StartupError}" Foreground="#A44B13" TextWrapping="Wrap" />
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </DockPanel>
</Window>
